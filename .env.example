VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional temporary public resource endpoint for demo/transition.
# When set, public resource search/context calls use this Supabase project,
# while auth and app data continue to use VITE_SUPABASE_URL above.
VITE_PUBLIC_RESOURCE_SUPABASE_URL=https://public-resource-project.supabase.co
VITE_PUBLIC_RESOURCE_ANON_KEY=public-resource-anon-key

# Supabase Edge Function Secrets (do not expose in Vite/client env)
# AI_API_KEY=your-ai-provider-api-key
# AI_MODEL=deepseek-chat
# TAVILY_API_KEY=your-web-search-api-key
# Optional override for a Tavily-compatible search endpoint:
# WEB_SEARCH_URL=https://api.tavily.com/search
